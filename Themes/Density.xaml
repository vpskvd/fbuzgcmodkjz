<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Strict 4px spacing scale (4, 8, 12, 16, 20, 24, 32) -->
    <x:Double x:Key="SpacingXXS">4</x:Double>
    <x:Double x:Key="SpacingXS">8</x:Double>
    <x:Double x:Key="SpacingSM">12</x:Double>
    <x:Double x:Key="SpacingMD">16</x:Double>
    <x:Double x:Key="SpacingLG">20</x:Double>
    <x:Double x:Key="SpacingXL">24</x:Double>
    <x:Double x:Key="SpacingXXL">32</x:Double>

    <!-- Fluent 2.0 container padding & control dimensions -->
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="CompactCardPadding">16</Thickness>
    <Thickness x:Key="SettingsCardPadding">16,0</Thickness>
    <Thickness x:Key="PageInsets">24,20</Thickness>

    <!-- Typography scale (weight 400-600, zero small negative tracking) -->
    <x:Double x:Key="CaptionFontSize">12</x:Double>
    <x:Double x:Key="BodyFontSize">13</x:Double>
    <x:Double x:Key="HelperFontSize">12</x:Double>

    <!-- Fluent 2.0 corner hierarchy (nested math: outer 8, inner 4) -->
    <CornerRadius x:Key="CardRadius">8</CornerRadius>
    <CornerRadius x:Key="SectionRadius">6</CornerRadius>
    <CornerRadius x:Key="ControlRadius">4</CornerRadius>
    <CornerRadius x:Key="KeycapRadius">4</CornerRadius>

</ResourceDictionary>
