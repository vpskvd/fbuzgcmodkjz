<Window
    x:Class="InstantReplay.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InstantReplay">

    <Grid x:Name="RootGrid" Background="{ThemeResource BgBrush}"
          SizeChanged="RootGrid_SizeChanged" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="PagesHost" Grid.Row="1">

            <!-- Home uses one scrolling, virtualized list with the hero and filters in its header. -->
            <Grid x:Name="HomePage">
                <GridView x:Name="GalleryGrid"
                          Loaded="GalleryGrid_Loaded" SizeChanged="GalleryGrid_SizeChanged"
                          Padding="18,0,18,8"
                          ItemContainerStyle="{StaticResource CleanGalleryGridViewItemStyle}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="GalleryGrid_ItemClick"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollMode="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <GridView.Header>
                        <StackPanel Margin="6,20,6,12" Spacing="16">
                            <!-- 1. HERO REPLAY DECK -->
                            <Grid x:Name="HeroContainer">
                                <Border x:Name="HeroCard" Style="{StaticResource Card}"
                                        Background="{ThemeResource HeroCardBrush}" Padding="20">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="64" Height="64" CornerRadius="8" VerticalAlignment="Center"
                                                Background="{ThemeResource SurfaceElevatedBrush}" BorderThickness="1"
                                                BorderBrush="{ThemeResource SurfaceBorderBrush}">
                                            <local:MediaOrb x:Name="HeroOrnament" Width="46" Height="46"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Style="{StaticResource DisplayTitle}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       AutomationProperties.HeadingLevel="Level1">
                                                <Run Text="instant replay"/>
                                                <Run Text="&#x2009;" FontSize="12"/>
                                                <Run x:Name="HeroBufferText" Text="0 s / 60 s" FontSize="12" FontWeight="Normal"
                                                     Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                            </TextBlock>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{ThemeResource KeycapBgBrush}" BorderBrush="{ThemeResource KeycapBorderBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="6,0" MinHeight="20"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Name="HeroHotkeyText" Text="shift + s" Style="{StaticResource CenteredCaption}"
                                                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                                                </Border>
                                                <TextBlock x:Name="HeroSummaryText" Grid.Column="1" Text="60 fps · whole desktop"
                                                           Style="{StaticResource CenteredCaption}" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button FontFamily="Segoe UI" x:Name="SaveReplayButton"
                                                    AutomationProperties.Name="save replay"
                                                    Visibility="Collapsed"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    MinWidth="128"
                                                    Click="SaveReplayButton_Click"
                                                    ToolTipService.ToolTip="save buffered replay now">
                                                <TextBlock x:Name="SaveReplayLabel"
                                                           Text="save replay"
                                                           Style="{StaticResource ToolbarLabel}"
                                                           FontWeight="SemiBold"/>
                                            </Button>

                                            <Button FontFamily="Segoe UI" x:Name="StartReplayButton"
                                                    AutomationProperties.Name="start replay"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    MinWidth="132"
                                                    Click="StartStopButton_Click">
                                                <TextBlock x:Name="StartReplayText"
                                                           Text="start replay"
                                                           Style="{StaticResource ToolbarLabel}"
                                                           FontWeight="SemiBold"/>
                                            </Button>

                                            <Button FontFamily="Segoe UI" x:Name="StopReplayButton"
                                                    AutomationProperties.Name="stop"
                                                    Visibility="Collapsed"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    MinWidth="120"
                                                    Click="StartStopButton_Click">
                                                <TextBlock x:Name="StopReplayText"
                                                           Text="stop"
                                                           Style="{StaticResource ToolbarLabel}"
                                                           FontWeight="SemiBold"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Concise Save Flash Confirmation Border -->
                                <Border x:Name="HeroSaveFlash"
                                        CornerRadius="8"
                                        BorderBrush="{ThemeResource AccentBrush}"
                                        BorderThickness="1.5"
                                        Opacity="0"
                                        IsHitTestVisible="False"/>
                            </Grid>

                            <!-- 2. GALLERY SECTION -->
                            <StackPanel x:Name="GallerySection" Spacing="12">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock AutomationProperties.HeadingLevel="Level2"
                                               Style="{StaticResource SectionTitle}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxLines="1">
                                        <Run Text="gallery"/>
                                        <Run Text="&#x2009;" FontSize="12"/>
                                        <Run x:Name="GalleryCountText" Text="0 clips" FontSize="12" FontWeight="Normal"
                                             Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextTertiaryBrush}"/>
                                    </TextBlock>

                                    <Button FontFamily="Segoe UI" x:Name="OpenFolderButton"
                                            Grid.Column="1"
                                            Style="{StaticResource BaseButtonStyle}"
                                            Height="32"
                                            CornerRadius="4"
                                            Padding="12,0"
                                            Click="OpenReplaysFolderButton_Click"
                                            ToolTipService.ToolTip="open replay folder">
                                        <TextBlock x:Name="GalleryOpenFolderText"
                                                   Text="open folder"
                                                   Style="{StaticResource ToolbarLabel}"/>
                                    </Button>
                                </Grid>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="CategoryFilterBar"
                                                Orientation="Horizontal"
                                                Spacing="8"/>
                                </ScrollViewer>
                                <Border x:Name="GalleryEmptyState"
                                        Visibility="Collapsed"
                                        Style="{StaticResource Card}"
                                        Padding="24,32">
                                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                                        <TextBlock Text="no replays yet"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="EmptyGalleryHintText"
                                                   Text="press shift + s while recording to save your first clip."
                                                   Style="{StaticResource Mono}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="400"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </GridView.Header>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="270" ItemHeight="220"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection/>
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:ReplayItem">
                            <Border x:Name="CardRoot"
                                    CornerRadius="8"
                                    Background="{ThemeResource SurfaceBrush}"
                                    BorderBrush="{ThemeResource SurfaceBorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="60"/>
                                    </Grid.RowDefinitions>
                                    <Grid CornerRadius="7,7,0,0"
                                          Background="{ThemeResource SurfaceElevatedBrush}">
                                        <Path Width="24" Height="20" Stretch="Uniform"
                                              Stroke="{ThemeResource TextTertiaryBrush}"
                                              StrokeThickness="1.5"
                                              Opacity="0.32"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 2,3 H 18 C 19.1,3 20,3.9 20,5 V 15 C 20,16.1 19.1,17 18,17 H 2 C 0.9,17 0,16.1 0,15 V 5 C 0,3.9 0.9,3 2,3 Z M 8,7 L 13,10 L 8,13 Z"/>
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                               Stretch="UniformToFill"/>

                                        <Rectangle Height="48"
                                                   VerticalAlignment="Bottom"
                                                   IsHitTestVisible="False"
                                                   Fill="{ThemeResource MediaBottomScrimBrush}"/>
                                        <Rectangle x:Name="ThumbHoverScrim"
                                                   IsHitTestVisible="False"
                                                   Fill="{ThemeResource MediaHoverDimBrush}"
                                                   Opacity="0"/>

                                        <Border x:Name="PlayOrb"
                                                Width="36"
                                                Height="36"
                                                CornerRadius="18"
                                                Background="{ThemeResource MediaOverlayChipBrush}"
                                                BorderBrush="{ThemeResource MediaOverlayChipBorderBrush}"
                                                BorderThickness="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Opacity="0.90">
                                            <Path Width="10" Height="12" Stretch="Uniform"
                                                  Margin="2,0,0,0"
                                                  Fill="{StaticResource MediaPillForegroundBrush}"
                                                  Data="M 1,0.5 L 11,6.5 L 1,12.5 Z"/>
                                        </Border>

                                        <!-- Non-overlapping Top Badges -->
                                        <Grid Margin="8"
                                              ColumnSpacing="8"
                                              VerticalAlignment="Top">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Style="{StaticResource MediaBadge}"
                                                    HorizontalAlignment="Left"
                                                    ToolTipService.ToolTip="{x:Bind Category}">
                                                <TextBlock Text="{x:Bind BadgeCategory}" Style="{StaticResource MediaBadgeLabel}"/>
                                            </Border>

                                            <Border x:Name="ClipMetricsBadge" Grid.Column="1"
                                                    Style="{StaticResource MediaBadge}"
                                                    HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind FpsText, Mode=OneWay}"
                                                               Visibility="{x:Bind BadgeFpsVisibility, Mode=OneWay}"
                                                               Style="{StaticResource MediaBadgeLabel}" Foreground="#B9C2D0"/>
                                                    <TextBlock Text="·" Visibility="{x:Bind BadgeFpsVisibility, Mode=OneWay}"
                                                               Style="{StaticResource MediaBadgeLabel}" Foreground="#B9C2D0"/>
                                                    <TextBlock Text="{x:Bind SizeText, Mode=OneWay}"
                                                               Style="{StaticResource MediaBadgeLabel}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Duration Stamp -->
                                        <Border x:Name="ClipDurationBadge" Style="{StaticResource MediaBadge}"
                                                Margin="8"
                                                MinWidth="44"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom">
                                            <TextBlock x:Name="ClipDurationLabel"
                                                       Text="{x:Bind DurationText, Mode=OneWay}"
                                                       Style="{StaticResource MediaBadgeLabel}"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       OpticalMarginAlignment="TrimSideBearings"
                                                       RenderTransform="{x:Null}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Card Footer (timestamp + edit marker & resolution — never repeats badge label) -->
                                    <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind CardTitleText, Mode=OneWay}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       Typography.NumeralAlignment="Tabular"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{x:Bind ResolutionText, Mode=OneWay}"
                                                       FontSize="11.5"
                                                       Typography.NumeralAlignment="Tabular"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                    VerticalAlignment="Center">
                                            <Button FontFamily="Segoe UI" Style="{StaticResource MediaCardActionButtonStyle}"
                                                    AutomationProperties.Name="show in file explorer"
                                                    Click="CardOpenFolderButton_Click"
                                                    ToolTipService.ToolTip="show in file explorer">
                                                <Path Width="16" Height="16" Stretch="None"
                                                      IsHitTestVisible="False"
                                                      Stroke="{ThemeResource TextSecondaryBrush}"
                                                      StrokeThickness="1.5"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      VerticalAlignment="Center"
                                                      Data="M 2,5 Q 2,4 3,4 H 6.5 L 8,5.5 H 13 Q 14,5.5 14,6.5 V 13 Q 14,14 13,14 H 3 Q 2,14 2,13 Z"/>
                                            </Button>
                                            <Button FontFamily="Segoe UI" Style="{StaticResource MediaCardActionButtonStyle}"
                                                    AutomationProperties.Name="delete clip"
                                                    Click="CardDeleteButton_Click"
                                                    ToolTipService.ToolTip="delete clip">
                                                <Path Width="16" Height="16" Stretch="None"
                                                      IsHitTestVisible="False"
                                                      Stroke="{ThemeResource TextSecondaryBrush}"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      VerticalAlignment="Center"
                                                      Data="M 2.5,4.5 H 13.5 M 6,4.5 V 3 Q 6,2 7,2 H 9 Q 10,2 10,3 V 4.5 M 4,4.5 V 13 Q 4,14 5,14 H 11 Q 12,14 12,13 V 4.5 M 6.5,7 V 11.5 M 9.5,7 V 11.5"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- PAGE 2: SETTINGS (scrolls cleanly beneath full-width blurred header) -->
            <ScrollViewer x:Name="SettingsPage"
                          Style="{StaticResource PageScrollViewerStyle}"
                          Foreground="{ThemeResource TextPrimaryBrush}"
                          Visibility="Collapsed"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid Padding="{StaticResource PageInsets}">
                    <StackPanel x:Name="SettingsContent"
                                MaxWidth="720"
                                HorizontalAlignment="Stretch"
                                Spacing="24">

                        <TextBlock Text="settings" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1"/>

                        <!-- 1. REPLAY TARGET -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="replay target" Style="{StaticResource SettingGroupHeader}" AutomationProperties.HeadingLevel="Level2"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <local:SettingRow Label="capture target">
                                        <ComboBox FontFamily="Segoe UI" x:Name="CaptureTargetCombo"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="4"
                                                  SelectionChanged="CaptureTargetCombo_SelectionChanged">
                                            <ComboBoxItem FontFamily="Segoe UI" Content="whole desktop"/>
                                            <ComboBoxItem FontFamily="Segoe UI" Content="game capture"/>
                                        </ComboBox>
                                    </local:SettingRow>

                                    <Rectangle x:Name="MonitorDivider" Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow x:Name="CaptureMonitorRow" Label="display">
                                        <ComboBox FontFamily="Segoe UI" x:Name="CaptureMonitorCombo"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="4"
                                                  SelectionChanged="CaptureMonitorCombo_SelectionChanged"/>
                                    </local:SettingRow>

                                    <Rectangle x:Name="GamesRuleDivider" Height="1" Fill="{ThemeResource HairlineBrush}" Visibility="Collapsed"/>

                                    <local:SettingRow x:Name="CustomGamesRow" Label="recognized games" Visibility="Collapsed">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="GamesSummaryText"
                                                       Text="built-in game catalog"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button FontFamily="Segoe UI" Grid.Column="1"
                                                    Style="{StaticResource SettingsInputButtonStyle}"
                                                    Padding="12,0"
                                                    Content="manage..."
                                                    Click="ManageGamesButton_Click"/>
                                        </Grid>
                                    </local:SettingRow>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow Label="show mouse cursor">
                                        <ToggleSwitch FontFamily="Segoe UI" x:Name="CaptureCursorToggle"
                                                      HorizontalAlignment="Right"
                                                      MinWidth="0"
                                                      OnContent=""
                                                      OffContent=""
                                                      Toggled="WindowCaptureOption_Changed"/>
                                    </local:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 2. VIDEO QUALITY -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="video quality" Style="{StaticResource SettingGroupHeader}" AutomationProperties.HeadingLevel="Level2"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <local:SettingRow Label="replay duration">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox FontFamily="Segoe UI" x:Name="DurationCombo"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"
                                                      CornerRadius="4"
                                                      SelectionChanged="DurationCombo_SelectionChanged">
                                                <ComboBoxItem FontFamily="Segoe UI" Content="30 seconds"/>
                                                <ComboBoxItem FontFamily="Segoe UI" Content="60 seconds"/>
                                                <ComboBoxItem FontFamily="Segoe UI" Content="120 seconds"/>
                                                <ComboBoxItem FontFamily="Segoe UI" Content="custom"/>
                                            </ComboBox>
                                            <Canvas x:Name="DurationCustomWrap" Grid.Column="1"
                                                    Width="0" Height="32" Visibility="Collapsed"
                                                    VerticalAlignment="Center" IsHitTestVisible="False"
                                                    SizeChanged="ClipDisclosure_SizeChanged">
                                                <Grid x:Name="DurationCustomContent" Canvas.Left="8" Width="96" Height="32"
                                                      ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox FontFamily="Segoe UI" x:Name="DurationCustomBox"
                                                             Style="{StaticResource CompactNumberTextBoxStyle}"
                                                             AutomationProperties.Name="replay duration in seconds"
                                                             PlaceholderText="60"
                                                             InputScope="Number"
                                                             TextChanged="DurationCustomBox_TextChanged"
                                                             LostFocus="DurationCustomBox_LostFocus"/>
                                                    <TextBlock Grid.Column="1" Text="s"
                                                               Style="{StaticResource ToolbarLabel}"
                                                               Foreground="{ThemeResource TextTertiaryBrush}"
                                                               IsHitTestVisible="False"/>
                                                </Grid>
                                            </Canvas>
                                        </Grid>
                                    </local:SettingRow>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow Label="frame rate">
                                        <ComboBox FontFamily="Segoe UI" x:Name="FpsCombo"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="4"
                                                  SelectionChanged="FpsCombo_SelectionChanged">
                                            <ComboBoxItem FontFamily="Segoe UI" Content="30 fps"/>
                                            <ComboBoxItem FontFamily="Segoe UI" Content="60 fps"/>
                                            <ComboBoxItem FontFamily="Segoe UI" Content="120 fps"/>
                                        </ComboBox>
                                    </local:SettingRow>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow Label="quality">
                                        <ComboBox FontFamily="Segoe UI" x:Name="QualityCombo"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="4"
                                                  SelectionChanged="QualityCombo_SelectionChanged">
                                            <ComboBoxItem FontFamily="Segoe UI" Content="low"/>
                                            <ComboBoxItem FontFamily="Segoe UI" Content="balanced"/>
                                            <ComboBoxItem FontFamily="Segoe UI" Content="high"/>
                                            <ComboBoxItem FontFamily="Segoe UI" Content="very high"/>
                                        </ComboBox>
                                    </local:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 3. AUDIO -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="audio" Style="{StaticResource SettingGroupHeader}" AutomationProperties.HeadingLevel="Level2"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <local:SettingRow Label="microphone">
                                        <ComboBox FontFamily="Segoe UI" x:Name="MicCombo"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="4"
                                                  SelectionChanged="MicCombo_SelectionChanged"/>
                                    </local:SettingRow>

                                    <Border Background="{ThemeResource CardSecondaryBrush}"
                                            BorderBrush="{ThemeResource HairlineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,8"
                                            Margin="0,0,0,12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="108"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="MicStatusLabel"
                                                       Grid.Column="0"
                                                       Text="detecting active microphone..."
                                                       Style="{StaticResource CenteredCaption}"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1"
                                                    Height="3"
                                                    CornerRadius="1.5"
                                                    Background="{ThemeResource TrackBrush}"
                                                    VerticalAlignment="Center">
                                                <Border x:Name="MicLevelBarFill"
                                                        Height="3"
                                                        CornerRadius="1.5"
                                                        Background="{ThemeResource AccentIndicatorBrush}"
                                                        RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform x:Name="MicLevelBarScale" ScaleX="0" ScaleY="1"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                            <Button FontFamily="Segoe UI" x:Name="DetectMicButton"
                                                    Grid.Column="2"
                                                    Style="{StaticResource BaseButtonStyle}"
                                                    Height="28"
                                                    MinHeight="28"
                                                    CornerRadius="4"
                                                    Padding="12,0"
                                                    FontSize="12"
                                                    Content="detect active"
                                                    Click="DetectMicButton_Click"
                                                    ToolTipService.ToolTip="scan active microphones and select speaking input or default"/>
                                        </Grid>
                                    </Border>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow Label="record microphone">
                                        <ToggleSwitch FontFamily="Segoe UI" x:Name="MicToggle"
                                                      HorizontalAlignment="Right"
                                                      MinWidth="0"
                                                      OnContent=""
                                                      OffContent=""
                                                      Toggled="MicToggle_Changed"/>
                                    </local:SettingRow>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow x:Name="RecordAudioRow" Label="record system audio">
                                        <ToggleSwitch FontFamily="Segoe UI" x:Name="SysAudioToggle"
                                                      HorizontalAlignment="Right"
                                                      MinWidth="0"
                                                      OnContent=""
                                                      OffContent=""
                                                      Toggled="SysAudioToggle_Changed"/>
                                    </local:SettingRow>

                                    <Grid x:Name="SystemAudioSourceSection" SizeChanged="ClipDisclosure_SizeChanged">
                                    <StackPanel x:Name="SystemAudioSourceContent" VerticalAlignment="Top">
                                        <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                        <local:SettingRow Label="system audio source">
                                            <ComboBox FontFamily="Segoe UI" x:Name="SysAudioModeCombo"
                                                      HorizontalAlignment="Stretch"
                                                      CornerRadius="4"
                                                      SelectionChanged="SysAudioModeCombo_SelectionChanged">
                                                <ComboBoxItem FontFamily="Segoe UI" Content="all desktop audio"/>
                                                <ComboBoxItem FontFamily="Segoe UI" Content="selected apps only"/>
                                            </ComboBox>
                                        </local:SettingRow>

                                        <Grid x:Name="SelectedAudioAppsPanel" Visibility="Collapsed" IsHitTestVisible="False" SizeChanged="ClipDisclosure_SizeChanged">
                                            <Border x:Name="SelectedAudioAppsContent" VerticalAlignment="Top"
                                                Background="{ThemeResource CardSecondaryBrush}"
                                                BorderBrush="{ThemeResource HairlineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,8"
                                                Margin="0,0,0,12">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="recorded applications"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <Button FontFamily="Segoe UI" x:Name="RefreshAudioAppsButton"
                                                            Grid.Column="1"
                                                            Style="{StaticResource BaseButtonStyle}"
                                                            Height="26"
                                                            MinHeight="26"
                                                            Padding="10,0"
                                                            CornerRadius="4"
                                                            FontSize="11.5"
                                                            Content="refresh"
                                                            Click="RefreshAudioAppsButton_Click"/>
                                                </Grid>
                                                <TextBlock x:Name="SelectedAudioHint" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                                <ScrollViewer Height="146" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                                                    <StackPanel x:Name="AudioAppsListPanel" Spacing="4"/>
                                                </ScrollViewer>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox FontFamily="Segoe UI" x:Name="AddAudioAppBox"
                                                             Style="{StaticResource CompactNumberTextBoxStyle}"
                                                             Padding="12,0"
                                                             PlaceholderText="executable name, e.g. discord.exe"
                                                             KeyDown="AddAudioAppBox_KeyDown"/>
                                                    <Button FontFamily="Segoe UI" x:Name="AddAudioAppButton"
                                                            Grid.Column="1"
                                                            Style="{StaticResource BaseButtonStyle}"
                                                            Height="32"
                                                            MinHeight="32"
                                                            Padding="12,0"
                                                            CornerRadius="4"
                                                            FontSize="12"
                                                            Content="add"
                                                            Click="AddAudioAppButton_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        </Grid>
                                    </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 4. STORAGE AND HOTKEYS -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="storage and hotkeys" Style="{StaticResource SettingGroupHeader}" AutomationProperties.HeadingLevel="Level2"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="save location"
                                               FontSize="13.5"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               Margin="0,12,0,8"/>
                                    <Grid ColumnSpacing="16" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="248"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox FontFamily="Segoe UI" x:Name="SaveLocationBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource CompactNumberTextBoxStyle}"
                                                 Padding="10,0"
                                                 TextChanged="SaveLocationBox_TextChanged"/>
                                        <Button FontFamily="Segoe UI" x:Name="BrowseSaveLocationButton"
                                                Grid.Column="1"
                                                HorizontalAlignment="Stretch"
                                                Style="{StaticResource SettingsInputButtonStyle}"
                                                Click="BrowseSaveLocationButton_Click">
                                            <TextBlock x:Name="BrowseSaveText"
                                                       Text="browse"
                                                       Style="{StaticResource ToolbarLabel}"/>
                                        </Button>
                                    </Grid>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow Label="save replay hotkey">
                                        <Button FontFamily="Segoe UI" x:Name="HotkeyCaptureButton"
                                                HorizontalAlignment="Stretch"
                                                Style="{StaticResource SettingsInputButtonStyle}"
                                                Click="HotkeyCaptureButton_Click">
                                            <TextBlock x:Name="HotkeyCaptureText"
                                                       Text="shift + s"
                                                       Style="{StaticResource ToolbarLabel}"/>
                                        </Button>
                                    </local:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 5. APP -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="app" Style="{StaticResource SettingGroupHeader}" AutomationProperties.HeadingLevel="Level2"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <local:SettingRow Label="start with windows">
                                        <ToggleSwitch FontFamily="Segoe UI" x:Name="StartupToggle"
                                                      HorizontalAlignment="Right"
                                                      MinWidth="0"
                                                      OnContent=""
                                                      OffContent=""
                                                      Toggled="StartupToggle_Changed"/>
                                    </local:SettingRow>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow Label="dark mode">
                                        <ToggleSwitch FontFamily="Segoe UI" x:Name="ThemeToggle"
                                                      AutomationProperties.Name="dark mode toggle"
                                                      HorizontalAlignment="Right"
                                                      MinWidth="0"
                                                      OnContent=""
                                                      OffContent=""
                                                      Toggled="ThemeToggle_Changed"/>
                                    </local:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 6. ADVANCED -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="advanced" Style="{StaticResource SettingGroupHeader}" AutomationProperties.HeadingLevel="Level2"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <Border Background="{ThemeResource WarningBgBrush}"
                                            BorderBrush="{ThemeResource WarningBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,8"
                                            Margin="0,12">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="capture compatibility"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextPrimaryBrush}"/>
                                            <TextBlock Text="encoder and capture-method changes can affect performance and fullscreen compatibility. auto and windows graphics capture are recommended."
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <local:SettingRow Label="video encoder">
                                        <ComboBox FontFamily="Segoe UI" x:Name="EncoderCombo"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="4"
                                                  SelectionChanged="EncoderCombo_SelectionChanged">
                                            <ComboBoxItem FontFamily="Segoe UI" Content="auto"/>
                                            <ComboBoxItem FontFamily="Segoe UI" Content="hardware"/>
                                            <ComboBoxItem FontFamily="Segoe UI" Content="software"/>
                                        </ComboBox>
                                    </local:SettingRow>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow Label="capture method">
                                        <ComboBox FontFamily="Segoe UI" x:Name="CaptureMethodCombo"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="4"
                                                  SelectionChanged="CaptureMethodCombo_SelectionChanged">
                                            <ComboBoxItem FontFamily="Segoe UI" x:Name="CaptureAutoItem" Content="auto"/>
                                            <ComboBoxItem FontFamily="Segoe UI" x:Name="CaptureWgcItem" Content="windows graphics capture"/>
                                            <ComboBoxItem FontFamily="Segoe UI" x:Name="CaptureDxgiItem" Content="dxgi desktop duplication"/>
                                        </ComboBox>
                                    </local:SettingRow>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow Label="debug logging">
                                        <ToggleSwitch FontFamily="Segoe UI" x:Name="DebugToggle"
                                                      HorizontalAlignment="Right"
                                                      MinWidth="0"
                                                      OnContent=""
                                                      OffContent=""
                                                      Toggled="DebugToggle_Changed"/>
                                    </local:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 7. UPDATES -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="updates" Style="{StaticResource SettingGroupHeader}" AutomationProperties.HeadingLevel="Level2"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <local:SettingRow Label="check automatically">
                                        <ToggleSwitch FontFamily="Segoe UI" x:Name="AutoUpdateToggle"
                                                      HorizontalAlignment="Right"
                                                      MinWidth="0"
                                                      OnContent=""
                                                      OffContent=""
                                                      Toggled="AutoUpdateToggle_Changed"/>
                                    </local:SettingRow>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <Grid MinHeight="56" Padding="0,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="UpdateVersionText"
                                                       Text="version"
                                                       FontSize="13.5"
                                                       Foreground="{ThemeResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="UpdateStatusText"
                                                       Text="check github releases for newer builds"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Button FontFamily="Segoe UI" x:Name="CheckUpdateButton"
                                                Grid.Column="1"
                                                AutomationProperties.Name="check for updates"
                                                Style="{StaticResource BaseButtonStyle}"
                                                Height="32"
                                                MinHeight="32"
                                                Padding="14,0"
                                                CornerRadius="4"
                                                VerticalAlignment="Center"
                                                Click="CheckUpdateButton_Click">
                                            <TextBlock x:Name="CheckUpdateButtonText"
                                                       Text="check for updates"
                                                       Style="{StaticResource ToolbarLabel}"
                                                       FontWeight="Medium"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- INLINE REPLAY VIEWER OVERLAY -->
            <Grid x:Name="ViewerPage"
                  Visibility="Collapsed"
                  Background="{ThemeResource BgBrush}"
                  Padding="{StaticResource PageInsets}"
                  Canvas.ZIndex="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Properly spaced non-colliding viewer toolbar -->
                <Grid x:Name="ViewerToolbar" Margin="0,0,0,12" MinHeight="48" Padding="8,0" ColumnSpacing="12"
                      Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button FontFamily="Segoe UI" x:Name="ViewerBackButton"
                            AutomationProperties.Name="back to gallery"
                            Style="{StaticResource BaseButtonStyle}"
                            Height="32"
                            MinHeight="32"
                            CornerRadius="4"
                            Padding="12,0"
                            Click="ViewerBackButton_Click">
                        <TextBlock x:Name="ViewerBackLabel"
                                   Text="back to gallery"
                                   Style="{StaticResource ToolbarLabel}"/>
                    </Button>

                    <Grid Grid.Column="1"
                          ColumnSpacing="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource SurfaceElevatedBrush}"
                                BorderBrush="{ThemeResource HairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Height="28"
                                Padding="8,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="ViewerCategoryText"
                                       Text="desktop"
                                       Style="{StaticResource CenteredCaption}"
                                       FontWeight="Medium"
                                       MaxWidth="200"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </Border>
                        <TextBlock x:Name="ViewerMetaText"
                                   Grid.Column="1"
                                   Text=""
                                   Style="{StaticResource CenteredCaption}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button FontFamily="Segoe UI" x:Name="ViewerEditButton"
                                AutomationProperties.Name="edit"
                                Style="{StaticResource BaseButtonStyle}"
                                Height="32"
                                MinHeight="32"
                                CornerRadius="4"
                                Padding="12,0"
                                Click="ViewerEditButton_Click">
                            <TextBlock x:Name="ViewerEditText"
                                       Text="edit"
                                       Style="{StaticResource ToolbarLabel}"/>
                        </Button>
                        <Button FontFamily="Segoe UI" x:Name="ViewerOpenFolderButton"
                                Style="{StaticResource BaseButtonStyle}"
                                Height="32"
                                MinHeight="32"
                                CornerRadius="4"
                                Padding="12,0"
                                Click="ViewerOpenFolderButton_Click">
                            <TextBlock x:Name="ViewerFolderText"
                                       Text="show in folder"
                                       Style="{StaticResource ToolbarLabel}"/>
                        </Button>
                        <Button FontFamily="Segoe UI" x:Name="ViewerDeleteButton"
                                AutomationProperties.Name="delete"
                                Style="{StaticResource DangerButtonStyle}"
                                Height="32"
                                MinHeight="32"
                                CornerRadius="4"
                                Padding="12,0"
                                Click="ConfirmDeleteButton_Click">
                            <TextBlock x:Name="ViewerDeleteText"
                                       Text="delete"
                                       Style="{StaticResource ToolbarLabel}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Trim Timeline + Crop Export Bar (Row 2, declared before WebView2 so UIA/Tab stays reachable) -->
                <Border x:Name="EditorBar"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Margin="0,12,0,0"
                        Background="{ThemeResource SurfaceBrush}"
                        BorderBrush="{ThemeResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <StackPanel Spacing="12">

                        <!-- Row A: Trim Range Slider -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button FontFamily="Segoe UI" x:Name="EditPlayPauseButton"
                                    AutomationProperties.Name="play pause trim preview"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Width="32" Height="30"
                                    Padding="0"
                                    CornerRadius="4"
                                    Click="EditPlayPauseButton_Click">
                                <Grid Width="14" Height="14">
                                    <Path x:Name="EditPlayIcon"
                                          Width="11" Height="12" Stretch="Uniform"
                                          Fill="{Binding Foreground, ElementName=EditPlayPauseButton}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M 1,0.5 L 10.5,6 L 1,11.5 Z"/>
                                    <Path x:Name="EditPauseIcon"
                                          Visibility="Collapsed"
                                          Width="10" Height="11" Stretch="Uniform"
                                          Fill="{Binding Foreground, ElementName=EditPlayPauseButton}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M 1,0 H 3.8 V 11 H 1 Z M 6.2,0 H 9 V 11 H 6.2 Z"/>
                                </Grid>
                            </Button>

                            <TextBlock x:Name="TrimStartText"
                                       Grid.Column="1"
                                       Text="0:00.0"
                                       Style="{StaticResource Mono}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       MinWidth="46"
                                       TextAlignment="Center"/>

                            <Grid x:Name="TrimTrackGrid"
                                  Grid.Column="2"
                                  Height="30"
                                  Background="Transparent"
                                  SizeChanged="TrimTrackGrid_SizeChanged"
                                  PointerPressed="TrimTrackGrid_PointerPressed"
                                  PointerMoved="TrimTrackGrid_PointerMoved"
                                  PointerReleased="TrimTrackGrid_PointerReleased"
                                  PointerCaptureLost="TrimTrackGrid_PointerReleased">
                                <Border Height="6"
                                        CornerRadius="3"
                                        Background="{ThemeResource TrackBrush}"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"/>
                                <Border x:Name="TrimActiveFill"
                                        Height="6"
                                        CornerRadius="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentIndicatorBrush}"
                                        IsHitTestVisible="False"/>
                                <Border x:Name="TrimPlayhead"
                                        Width="2"
                                        Height="22"
                                        CornerRadius="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource TextPrimaryBrush}"
                                        IsHitTestVisible="False"/>
                                <Border x:Name="TrimStartHandle"
                                        Width="12"
                                        Height="22"
                                        CornerRadius="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource TextPrimaryBrush}"
                                        BorderBrush="{ThemeResource BgBrush}"
                                        BorderThickness="1.5"
                                        IsHitTestVisible="False">
                                    <Border Width="2" Height="10" CornerRadius="1" Background="{ThemeResource BgBrush}"/>
                                </Border>
                                <Border x:Name="TrimEndHandle"
                                        Width="12"
                                        Height="22"
                                        CornerRadius="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource TextPrimaryBrush}"
                                        BorderBrush="{ThemeResource BgBrush}"
                                        BorderThickness="1.5"
                                        IsHitTestVisible="False">
                                    <Border Width="2" Height="10" CornerRadius="1" Background="{ThemeResource BgBrush}"/>
                                </Border>
                            </Grid>

                            <TextBlock x:Name="TrimEndText"
                                       Grid.Column="3"
                                       Text="0:00.0"
                                       Style="{StaticResource Mono}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       MinWidth="46"
                                       TextAlignment="Center"/>

                            <Border Grid.Column="4"
                                    Background="{ThemeResource SurfaceElevatedBrush}"
                                    BorderBrush="{ThemeResource HairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Height="28"
                                    Padding="8,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="TrimDurationText"
                                           Text="0.0s"
                                           Style="{StaticResource Mono}"
                                           FontSize="11.5"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>

                        <!-- Row B: Crop Aspect Ratios + Save as Separate Video -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="crop"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button FontFamily="Segoe UI" x:Name="CropRatioFreeButton"
                                        Content="free"
                                        Tag="free"
                                        Height="28"
                                        MinHeight="28"
                                        Padding="10,0"
                                        CornerRadius="4"
                                        FontSize="12"
                                        Style="{StaticResource FilterActiveButtonStyle}"
                                        Click="CropRatioButton_Click"/>
                                <Button FontFamily="Segoe UI" x:Name="CropRatio169Button"
                                        Content="16:9"
                                        Tag="16:9"
                                        Height="28"
                                        MinHeight="28"
                                        Padding="10,0"
                                        CornerRadius="4"
                                        FontSize="12"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Click="CropRatioButton_Click"/>
                                <Button FontFamily="Segoe UI" x:Name="CropRatio43Button"
                                        Content="4:3"
                                        Tag="4:3"
                                        Height="28"
                                        MinHeight="28"
                                        Padding="10,0"
                                        CornerRadius="4"
                                        FontSize="12"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Click="CropRatioButton_Click"/>
                                <Button FontFamily="Segoe UI" x:Name="CropRatio916Button"
                                        Content="9:16"
                                        Tag="9:16"
                                        Height="28"
                                        MinHeight="28"
                                        Padding="10,0"
                                        CornerRadius="4"
                                        FontSize="12"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Click="CropRatioButton_Click"/>
                                <Button FontFamily="Segoe UI" x:Name="CropRatio11Button"
                                        Content="1:1"
                                        Tag="1:1"
                                        Height="28"
                                        MinHeight="28"
                                        Padding="10,0"
                                        CornerRadius="4"
                                        FontSize="12"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Click="CropRatioButton_Click"/>

                                <Border Background="{ThemeResource SurfaceElevatedBrush}"
                                        BorderBrush="{ThemeResource HairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Height="28"
                                        Padding="8,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="CropInfoText"
                                               Text="—"
                                               Style="{StaticResource Mono}"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="EditExportProgressText"
                                           Visibility="Collapsed"
                                           Text="saving 0%"
                                           Style="{StaticResource Mono}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button FontFamily="Segoe UI" x:Name="EditCancelExportButton"
                                        Visibility="Collapsed"
                                        Content="cancel"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Height="28"
                                        MinHeight="28"
                                        Padding="12,0"
                                        CornerRadius="4"
                                        Click="EditCancelExportButton_Click"/>
                                <Button FontFamily="Segoe UI" x:Name="EditResetButton"
                                        Content="reset"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Height="28"
                                        MinHeight="28"
                                        Padding="12,0"
                                        CornerRadius="4"
                                        Click="EditResetButton_Click"/>
                                <Button FontFamily="Segoe UI" x:Name="EditSaveCopyButton"
                                        AutomationProperties.Name="save as new video"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Height="28"
                                        MinHeight="28"
                                        Padding="14,0"
                                        CornerRadius="4"
                                        Click="EditSaveCopyButton_Click">
                                    <TextBlock x:Name="EditSaveCopyText"
                                               Text="save copy"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <Grid x:Name="PlayerViewport"
                      Grid.Row="1"
                      SizeChanged="PlayerViewport_SizeChanged">
                    <Border x:Name="PlayerCard"
                            Background="{ThemeResource SurfaceElevatedBrush}"
                            CornerRadius="8"
                            BorderBrush="{ThemeResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <Grid x:Name="InlinePlayerHost">
                            <Grid x:Name="InlineWebHost" Opacity="0"/>
                            <Image x:Name="ViewerPoster"
                                   Visibility="Collapsed"
                                   Stretch="Uniform"
                                   IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================================================================ -->
        <!-- TOP FULL-WIDTH HEADER BAR (solid surface, zero blur)             -->
        <!-- ================================================================ -->
        <Grid x:Name="FloatingHeader" Grid.Row="0" SizeChanged="RootGrid_SizeChanged"
              Height="52"
              Background="{ThemeResource HeaderBarBrush}"
              BorderBrush="{ThemeResource HairlineBrush}"
              BorderThickness="0,0,0,1"
              Padding="12,0"
              Canvas.ZIndex="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Clean Status Indicator Only (no brand logo/text clutter) -->
            <Border x:Name="StatusPill"
                    Grid.Column="0"
                    Background="{ThemeResource CardSecondaryBrush}"
                    BorderBrush="{ThemeResource HairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Height="26"
                    Padding="8,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                <TextBlock x:Name="StatusHeadline"
                           Text="stopped"
                           Style="{StaticResource CenteredCaption}"
                           FontWeight="Medium"
                           Foreground="{ThemeResource TextSecondaryBrush}"/>
            </Border>

            <!-- Center: Horizontal Fluent 2.0 Selector Switcher -->
            <Border x:Name="NavSegmentedCapsule"
                    SizeChanged="RootGrid_SizeChanged"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="36" Padding="3"
                    Background="{ThemeResource NavSelectorTrayBrush}"
                    BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Border x:Name="NavActivePill" Width="92" Height="28" CornerRadius="6"
                            HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                            Background="{ThemeResource NavActivePillBrush}"
                            BorderBrush="{ThemeResource NavActivePillBorderBrush}" BorderThickness="1"/>

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button FontFamily="Segoe UI" x:Name="NavHomeButton"
                                AutomationProperties.Name="home"
                                Width="92"
                                Style="{StaticResource NavRailButtonStyle}"
                                Click="NavHomeButton_Click">
                            <TextBlock x:Name="NavHomeText"
                                       Text="home"
                                       Style="{StaticResource ToolbarLabel}"/>
                        </Button>

                        <Button FontFamily="Segoe UI" x:Name="NavSettingsButton"
                                AutomationProperties.Name="settings"
                                Width="92"
                                Style="{StaticResource NavRailButtonStyle}"
                                Click="NavSettingsButton_Click">
                            <TextBlock x:Name="NavSettingsText"
                                       Text="settings"
                                       Style="{StaticResource ToolbarLabel}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Window Caption Buttons -->
            <StackPanel x:Name="WindowButtonsCapsule"
                        SizeChanged="RootGrid_SizeChanged"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button FontFamily="Segoe UI" x:Name="MinimizeTitleButton"
                        AutomationProperties.Name="minimize"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        local:UiHover.HoverIconTone="Primary"
                        IsTabStop="False"
                        Click="MinimizeTitleButton_Click"
                        ToolTipService.ToolTip="minimize">
                    <Path Width="10" Height="2"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="{ThemeResource TextSecondaryBrush}"
                          Data="M 0,0.4 H 10 V 1.6 H 0 Z"/>
                </Button>
                <Button FontFamily="Segoe UI" x:Name="CloseTitleButton"
                        AutomationProperties.Name="hide to tray"
                        Style="{StaticResource TitleBarCloseButtonStyle}"
                        local:UiHover.HoverIconTone="White"
                        IsTabStop="False"
                        Click="CloseTitleButton_Click"
                        ToolTipService.ToolTip="hide to tray">
                    <Path Width="12" Height="12" Stretch="None"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Stroke="{ThemeResource TextSecondaryBrush}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M 2.5,2.5 L 9.5,9.5 M 9.5,2.5 L 2.5,9.5"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Keep notifications above the page without changing its available height. -->
        <StackPanel x:Name="BottomToastStack" Grid.Row="1"
                    Canvas.ZIndex="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    MaxWidth="640"
                    Spacing="0">

            <!-- STATUS INFOBAR -->
            <InfoBar FontFamily="Segoe UI" x:Name="StatusInfoBar"
                     Background="{ThemeResource FloatingSurfaceBrush}"
                     BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                     CornerRadius="8" Margin="16,0,16,10"
                     Visibility="Collapsed"
                     HorizontalAlignment="Center"
                     MaxWidth="560"
                     IsOpen="False"
                     IsIconVisible="False"
                     IsClosable="True"
                     Severity="Informational"
                     Closing="StatusInfoBar_Closing"
                     Closed="StatusInfoBar_Closed">
                <InfoBar.RenderTransform>
                    <TranslateTransform x:Name="StatusInfoOffset"/>
                </InfoBar.RenderTransform>
            </InfoBar>

            <!-- WEBVIEW2 RUNTIME WARNING -->
            <InfoBar FontFamily="Segoe UI" x:Name="WebViewRequirementBar"
                     Background="{ThemeResource FloatingSurfaceBrush}"
                     BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                     CornerRadius="8" Margin="16,0,16,10"
                     Visibility="Collapsed"
                     HorizontalAlignment="Center"
                     MaxWidth="560"
                     IsOpen="False"
                     IsIconVisible="False"
                     IsClosable="False"
                     Severity="Warning"
                     Title="webview2 runtime required"
                     Message="video playback requires the microsoft edge webview2 runtime.">
                <InfoBar.ActionButton>
                    <Button FontFamily="Segoe UI" Content="download webview2" Click="DownloadWebView2Button_Click"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- FLOATING UNSAVED CHANGES BAR -->
            <Border x:Name="PendingChangesFlyout"
                    Background="{ThemeResource FloatingSurfaceBrush}"
                    BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    MinHeight="48" Margin="16,0,16,10"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,0" VerticalAlignment="Center">
                    <TextBlock Text="unsaved changes"
                               Style="{StaticResource ToolbarLabel}"
                               FontWeight="Medium"
                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                    <Button FontFamily="Segoe UI" x:Name="PendingDiscardButton"
                            Style="{StaticResource BaseButtonStyle}"
                            Height="28"
                            MinHeight="28"
                            CornerRadius="4"
                            Padding="12,0"
                            Content="discard"
                            Click="PendingDiscardButton_Click"/>
                    <Button FontFamily="Segoe UI" x:Name="PendingSaveButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Height="28"
                            MinHeight="28"
                            CornerRadius="4"
                            Padding="16,0"
                            Content="save"
                            Click="PendingSaveButton_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Crisp 1px perimeter border framing the Acrylic window -->
        <Border IsHitTestVisible="False" Grid.RowSpan="2"
                BorderBrush="{ThemeResource WindowRimBorderBrush}"
                BorderThickness="1"
                Canvas.ZIndex="40"/>
    </Grid>
</Window>
