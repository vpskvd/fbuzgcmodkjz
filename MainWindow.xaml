<Window
    x:Class="InstantReplay.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InstantReplay">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource BgBrush}"
          SizeChanged="RootGrid_SizeChanged"
          KeyDown="RootGrid_KeyDown">

        <!-- ================================================================ -->
        <!-- CONTENT LAYER                                                    -->
        <!-- ================================================================ -->
        <Grid x:Name="PagesHost">

            <!-- PAGE 1: HOME (Hero -> Compact Telemetry -> Gallery) -->
            <ScrollViewer x:Name="HomePage"
                          Style="{StaticResource PageScrollViewerStyle}"
                          Foreground="{ThemeResource TextPrimaryBrush}"
                          Visibility="Visible"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid Padding="24,72,24,28">
                    <StackPanel MaxWidth="912"
                                HorizontalAlignment="Stretch"
                                Spacing="16">

                        <!-- 1. HERO REPLAY DECK -->
                        <Grid x:Name="HeroContainer">
                            <Border x:Name="HeroCard"
                                    Style="{StaticResource Card}"
                                    Background="{ThemeResource HeroCardBrush}"
                                    Padding="20">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 3D Kinetic Isometric Glass Prism Showcase (replaces circular aperture) -->
                                    <Border x:Name="HeroAperture"
                                            Width="64"
                                            Height="64"
                                            CornerRadius="8"
                                            Background="{ThemeResource SurfaceElevatedBrush}"
                                            BorderBrush="{ThemeResource SurfaceBorderBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <!-- Subtle 4x4 Recessed Instrument Dot Lattice -->
                                            <Canvas Width="44" Height="44" Opacity="0.34" IsHitTestVisible="False">
                                                <Ellipse Width="1.5" Height="1.5" Canvas.Left="6" Canvas.Top="6" Fill="{ThemeResource TextTertiaryBrush}"/>
                                                <Ellipse Width="1.5" Height="1.5" Canvas.Left="16" Canvas.Top="6" Fill="{ThemeResource TextTertiaryBrush}"/>
                                                <Ellipse Width="1.5" Height="1.5" Canvas.Left="26" Canvas.Top="6" Fill="{ThemeResource TextTertiaryBrush}"/>
                                                <Ellipse Width="1.5" Height="1.5" Canvas.Left="36" Canvas.Top="6" Fill="{ThemeResource TextTertiaryBrush}"/>
                                                <Ellipse Width="1.5" Height="1.5" Canvas.Left="6" Canvas.Top="16" Fill="{ThemeResource TextTertiaryBrush}"/>
                                                <Ellipse Width="1.5" Height="1.5" Canvas.Left="36" Canvas.Top="16" Fill="{ThemeResource TextTertiaryBrush}"/>
                                                <Ellipse Width="1.5" Height="1.5" Canvas.Left="6" Canvas.Top="26" Fill="{ThemeResource TextTertiaryBrush}"/>
                                                <Ellipse Width="1.5" Height="1.5" Canvas.Left="36" Canvas.Top="26" Fill="{ThemeResource TextTertiaryBrush}"/>
                                                <Ellipse Width="1.5" Height="1.5" Canvas.Left="6" Canvas.Top="36" Fill="{ThemeResource TextTertiaryBrush}"/>
                                                <Ellipse Width="1.5" Height="1.5" Canvas.Left="16" Canvas.Top="36" Fill="{ThemeResource TextTertiaryBrush}"/>
                                                <Ellipse Width="1.5" Height="1.5" Canvas.Left="26" Canvas.Top="36" Fill="{ThemeResource TextTertiaryBrush}"/>
                                                <Ellipse Width="1.5" Height="1.5" Canvas.Left="36" Canvas.Top="36" Fill="{ThemeResource TextTertiaryBrush}"/>
                                            </Canvas>

                                            <!-- Soft Inner Radial Highlight behind Prism (only when recording) -->
                                            <Ellipse x:Name="HeroCoreGlow"
                                                     Width="42"
                                                     Height="42"
                                                     Fill="{ThemeResource HeroCoreGlowBrush}"
                                                     Opacity="0"
                                                     IsHitTestVisible="False"/>

                                            <!-- Layer 1: Outer 3D Gimbal Diamond Frame -->
                                            <Grid x:Name="HeroPrismOuter"
                                                  Width="36"
                                                  Height="36"
                                                  Opacity="0.45"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                <Border Width="28"
                                                        Height="28"
                                                        CornerRadius="6"
                                                        Background="{ThemeResource CardSecondaryBrush}"
                                                        BorderBrush="{ThemeResource AccentButtonBorderBrush}"
                                                        BorderThickness="1.2"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <RotateTransform Angle="45"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>

                                            <!-- Layer 2: Mid Counter-Tilting Frosted Amber Glass Plane -->
                                            <Border x:Name="HeroPrismMid"
                                                    Width="24"
                                                    Height="24"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource AccentDimBrush}"
                                                    BorderBrush="{ThemeResource AccentIndicatorBrush}"
                                                    BorderThickness="1.35"
                                                    Opacity="0.50"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>

                                            <!-- Layer 3: Foreground Isometric Faceted Hex-Cube Wireframe + Core Spark -->
                                            <Canvas x:Name="HeroPrismCore"
                                                    Width="28"
                                                    Height="28"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.72">
                                                <!-- Isometric Cube Outer Hexagon & Internal Facets -->
                                                <Path Stroke="{ThemeResource AccentIndicatorBrush}"
                                                      StrokeThickness="1.45"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M 14,3 L 23.5,8.5 V 19.5 L 14,25 L 4.5,19.5 V 8.5 Z M 14,14 L 4.5,8.5 M 14,14 L 23.5,8.5 M 14,14 V 25"/>
                                                <!-- Bright Core Center Vertex -->
                                                <Polygon Points="14,10.5 17,12.25 17,15.75 14,17.5 11,15.75 11,12.25"
                                                         Fill="{ThemeResource AccentBrush}"/>
                                            </Canvas>

                                            <!-- Layer 4: Subtle Harmonic Micro-Bars along Bottom Rim -->
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="2.5"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,0,4"
                                                        Opacity="0.85">
                                                <Border x:Name="HeroBar1" Width="2" Height="6" CornerRadius="1" Background="{ThemeResource AccentIndicatorBrush}" RenderTransformOrigin="0.5,1"/>
                                                <Border x:Name="HeroBar2" Width="2" Height="8" CornerRadius="1" Background="{ThemeResource AccentIndicatorBrush}" RenderTransformOrigin="0.5,1"/>
                                                <Border x:Name="HeroBar3" Width="2" Height="7" CornerRadius="1" Background="{ThemeResource AccentIndicatorBrush}" RenderTransformOrigin="0.5,1"/>
                                                <Border x:Name="HeroBar4" Width="2" Height="5" CornerRadius="1" Background="{ThemeResource AccentIndicatorBrush}" RenderTransformOrigin="0.5,1"/>
                                            </StackPanel>

                                            <!-- Save Confirmation Rectangular Pulse Border -->
                                            <Border x:Name="HeroSaveBurstRing"
                                                    Width="62"
                                                    Height="62"
                                                    CornerRadius="8"
                                                    BorderBrush="{ThemeResource AccentBrush}"
                                                    BorderThickness="1.8"
                                                    Opacity="0"
                                                    IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>

                                    <!-- Status & Buffer Info + Hardware Keycap -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="4">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="12">
                                            <TextBlock Text="instant replay"
                                                       Style="{StaticResource DisplayTitle}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="HeroBufferText"
                                                       Text="0s / 60s"
                                                       Style="{StaticResource Mono}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="HeroSummaryText"
                                                       Text="buffering last 60 seconds at 60 fps · whole desktop"
                                                       Style="{StaticResource Caption}"
                                                       LineHeight="16"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                    Background="{ThemeResource KeycapBgBrush}"
                                                    BorderBrush="{ThemeResource KeycapBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Height="20"
                                                    Padding="7,0"
                                                    Margin="0,1,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="HeroHotkeyText"
                                                           Text="shift + s"
                                                           Style="{StaticResource Mono}"
                                                           FontSize="11"
                                                           LineHeight="12"
                                                           LineStackingStrategy="BlockLineHeight"
                                                           Margin="0,0,0,1"
                                                           VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Primary Actions -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                        <Button x:Name="SaveReplayButton"
                                                AutomationProperties.Name="save replay"
                                                Visibility="Collapsed"
                                                Style="{StaticResource AccentButtonStyle}"
                                                MinWidth="128"
                                                Click="SaveReplayButton_Click"
                                                ToolTipService.ToolTip="save buffered replay now">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Path Width="14" Height="14" Stretch="Uniform"
                                                      Stroke="{Binding Foreground, ElementName=SaveReplayButton}"
                                                      StrokeThickness="1.6"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      VerticalAlignment="Center"
                                                      Data="M 5.5,3.5 H 18.5 A 1.5,1.5 0 0 1 20,5 V 20.5 L 12,15.8 L 4,20.5 V 5 A 1.5,1.5 0 0 1 5.5,3.5 Z"/>
                                                <TextBlock x:Name="SaveReplayLabel"
                                                           Text="save replay"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="StartReplayButton"
                                                AutomationProperties.Name="start replay"
                                                Style="{StaticResource AccentButtonStyle}"
                                                MinWidth="132"
                                                Click="StartStopButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Path Width="13" Height="13" Stretch="Uniform"
                                                      Stroke="{Binding Foreground, ElementName=StartReplayButton}"
                                                      StrokeThickness="1.6"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      VerticalAlignment="Center"
                                                      Data="M 7,5 L 19,12 L 7,19 Z"/>
                                                <TextBlock x:Name="StartReplayText"
                                                           Text="start replay"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="StopReplayButton"
                                                AutomationProperties.Name="stop"
                                                Visibility="Collapsed"
                                                Style="{StaticResource DangerButtonStyle}"
                                                MinWidth="96"
                                                Click="StartStopButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Path Width="13" Height="13" Stretch="Uniform"
                                                      Stroke="{Binding Foreground, ElementName=StopReplayButton}"
                                                      StrokeThickness="1.6"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      VerticalAlignment="Center"
                                                      Data="M 6,4 H 18 A 2,2 0 0 1 20,6 V 18 A 2,2 0 0 1 18,20 H 6 A 2,2 0 0 1 4,18 V 6 A 2,2 0 0 1 6,4 Z"/>
                                                <TextBlock x:Name="StopReplayText"
                                                           Text="stop"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Concise Save Flash Confirmation Border -->
                            <Border x:Name="HeroSaveFlash"
                                    CornerRadius="8"
                                    BorderBrush="{ThemeResource AccentBrush}"
                                    BorderThickness="1.5"
                                    Background="{ThemeResource AccentDimBrush}"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                        </Grid>

                        <!-- 2. COMPACT SYSTEM TELEMETRY -->
                        <Grid x:Name="TelemetryRow" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- CPU Usage Card -->
                            <Border x:Name="CpuCard"
                                    Grid.Column="0"
                                    Background="{ThemeResource CardSecondaryBrush}"
                                    BorderBrush="{ThemeResource SurfaceBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,10">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Path Width="16" Height="16" Stretch="Uniform"
                                              Stroke="{ThemeResource TextTertiaryBrush}"
                                              StrokeThickness="1.5"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              VerticalAlignment="Center"
                                              Data="M 7,7 H 17 V 17 H 7 Z M 9.5,2 V 5 M 14.5,2 V 5 M 9.5,19 V 22 M 14.5,19 V 22 M 2,9.5 H 5 M 2,14.5 H 5 M 19,9.5 H 22 M 19,14.5 H 22 M 5,6.5 A 1.5,1.5 0 0 1 6.5,5 H 17.5 A 1.5,1.5 0 0 1 19,6.5 V 17.5 A 1.5,1.5 0 0 1 17.5,19 H 6.5 A 1.5,1.5 0 0 1 5,17.5 Z"/>

                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="cpu usage"
                                                       FontSize="12.5"
                                                       FontWeight="Medium"
                                                       Foreground="{ThemeResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="CpuHintText"
                                                       Text="overall processor load"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock x:Name="CpuValueText"
                                                   Grid.Column="2"
                                                   Text="—"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Typography.NumeralAlignment="Tabular"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Height="3"
                                            CornerRadius="1.5"
                                            Background="{ThemeResource TrackBrush}">
                                        <Border x:Name="CpuBarFill"
                                                Height="3"
                                                CornerRadius="1.5"
                                                Background="{ThemeResource AccentIndicatorBrush}"
                                                RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="CpuBarScale" ScaleX="0" ScaleY="1"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- System Memory Card -->
                            <Border x:Name="RamCard"
                                    Grid.Column="1"
                                    Background="{ThemeResource CardSecondaryBrush}"
                                    BorderBrush="{ThemeResource SurfaceBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,10">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Path Width="16" Height="16" Stretch="Uniform"
                                              Stroke="{ThemeResource TextTertiaryBrush}"
                                              StrokeThickness="1.5"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              VerticalAlignment="Center"
                                              Data="M 3,6.5 H 21 A 1.5,1.5 0 0 1 22.5,8 V 14.5 A 1.5,1.5 0 0 1 21,16 H 3 A 1.5,1.5 0 0 1 1.5,14.5 V 8 A 1.5,1.5 0 0 1 3,6.5 Z M 7,10 V 12.5 M 12,10 V 12.5 M 17,10 V 12.5 M 6,16 V 19.5 M 10,16 V 19.5 M 14,16 V 19.5 M 18,16 V 19.5"/>

                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="system memory"
                                                       FontSize="12.5"
                                                       FontWeight="Medium"
                                                       Foreground="{ThemeResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="RamHintText"
                                                       Text="in use"
                                                       FontSize="11"
                                                       Typography.NumeralAlignment="Tabular"
                                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock x:Name="RamValueText"
                                                   Grid.Column="2"
                                                   Text="—"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Typography.NumeralAlignment="Tabular"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Height="3"
                                            CornerRadius="1.5"
                                            Background="{ThemeResource TrackBrush}">
                                        <Border x:Name="RamBarFill"
                                                Height="3"
                                                CornerRadius="1.5"
                                                Background="{ThemeResource AccentIndicatorBrush}"
                                                RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="RamBarScale" ScaleX="0" ScaleY="1"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 3. GALLERY SECTION -->
                        <StackPanel x:Name="GallerySection" Spacing="12">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock Text="gallery"
                                               Style="{StaticResource SectionTitle}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GalleryCountText"
                                               Text="0 clips"
                                               Style="{StaticResource Mono}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextTertiaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button x:Name="OpenFolderButton"
                                        Grid.Column="1"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Height="32"
                                        CornerRadius="4"
                                        Padding="12,0"
                                        Click="OpenReplaysFolderButton_Click"
                                        ToolTipService.ToolTip="open videos\replays folder">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Path Width="14" Height="14" Stretch="Uniform"
                                              Stroke="{Binding Foreground, ElementName=OpenFolderButton}"
                                              StrokeThickness="1.5"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              VerticalAlignment="Center"
                                              Data="M 3,6.5 A 1.5,1.5 0 0 1 4.5,5 H 9.5 L 11.5,7.5 H 19.5 A 1.5,1.5 0 0 1 21,9 V 18 A 1.5,1.5 0 0 1 19.5,19.5 H 4.5 A 1.5,1.5 0 0 1 3,18 Z"/>
                                        <TextBlock x:Name="GalleryOpenFolderText"
                                                   Text="open folder"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="CategoryFilterBar"
                                            Orientation="Horizontal"
                                            Spacing="8"/>
                            </ScrollViewer>

                            <!-- Clip Grid: 3 * 296 + 2 * 12 = 912px aligned cleanly under Hero -->
                            <GridView x:Name="GalleryGrid"
                                      Margin="0,0,-12,0"
                                      ItemContainerStyle="{StaticResource CleanGalleryGridViewItemStyle}"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="GalleryGrid_ItemClick"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <GridView.ItemContainerTransitions>
                                    <TransitionCollection/>
                                </GridView.ItemContainerTransitions>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ReplayItem">
                                        <Border x:Name="CardRoot"
                                                Width="296"
                                                CornerRadius="8"
                                                Background="{ThemeResource SurfaceBrush}"
                                                BorderBrush="{ThemeResource SurfaceBorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <!-- 16:9 Thumbnail Viewport (296x168 on 4px grid) -->
                                                <Grid Height="168"
                                                      CornerRadius="7,7,0,0"
                                                      Background="{ThemeResource SurfaceElevatedBrush}">
                                                    <Path Width="24" Height="20" Stretch="Uniform"
                                                          Stroke="{ThemeResource TextTertiaryBrush}"
                                                          StrokeThickness="1.5"
                                                          Opacity="0.32"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M 2,3 H 18 C 19.1,3 20,3.9 20,5 V 15 C 20,16.1 19.1,17 18,17 H 2 C 0.9,17 0,16.1 0,15 V 5 C 0,3.9 0.9,3 2,3 Z M 8,7 L 13,10 L 8,13 Z"/>
                                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                                           Stretch="UniformToFill"/>

                                                    <Rectangle Height="48"
                                                               VerticalAlignment="Bottom"
                                                               IsHitTestVisible="False"
                                                               Fill="{ThemeResource MediaBottomScrimBrush}"/>
                                                    <Rectangle x:Name="ThumbHoverScrim"
                                                               IsHitTestVisible="False"
                                                               Fill="{ThemeResource MediaHoverDimBrush}"
                                                               Opacity="0"/>

                                                    <Border x:Name="PlayOrb"
                                                            Width="36"
                                                            Height="36"
                                                            CornerRadius="18"
                                                            Background="{ThemeResource MediaOverlayChipBrush}"
                                                            BorderBrush="{ThemeResource MediaOverlayChipBorderBrush}"
                                                            BorderThickness="1"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Opacity="0.90">
                                                        <Path Width="10" Height="12" Stretch="Uniform"
                                                              Margin="2,0,0,0"
                                                              Fill="{StaticResource MediaPillForegroundBrush}"
                                                              Data="M 1,0.5 L 11,6.5 L 1,12.5 Z"/>
                                                    </Border>

                                                    <!-- Non-overlapping Top Badges -->
                                                    <Grid Margin="8"
                                                          ColumnSpacing="8"
                                                          VerticalAlignment="Top">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0"
                                                                Background="{ThemeResource MediaOverlayChipBrush}"
                                                                BorderBrush="{ThemeResource MediaOverlayChipBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Height="22"
                                                                Padding="6,0"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                ToolTipService.ToolTip="{x:Bind Category}">
                                                            <Grid ColumnSpacing="6" VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Path Visibility="{x:Bind DesktopIconVisibility}"
                                                                      Width="13" Height="13" Stretch="Uniform"
                                                                      Stroke="{StaticResource MediaPillForegroundBrush}"
                                                                      StrokeThickness="1.5"
                                                                      StrokeLineJoin="Round"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      VerticalAlignment="Center"
                                                                      Data="M 3,4.5 H 21 A 1.5,1.5 0 0 1 22.5,6 V 15.5 A 1.5,1.5 0 0 1 21,17 H 3 A 1.5,1.5 0 0 1 1.5,15.5 V 6 A 1.5,1.5 0 0 1 3,4.5 Z M 8.5,20.5 H 15.5 M 12,17 V 20.5"/>
                                                                <Path Visibility="{x:Bind GameIconVisibility}"
                                                                      Width="13" Height="13" Stretch="Uniform"
                                                                      Stroke="{StaticResource MediaPillForegroundBrush}"
                                                                      StrokeThickness="1.5"
                                                                      StrokeLineJoin="Round"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      VerticalAlignment="Center"
                                                                      Data="M 6,12 H 10 M 8,10 V 14 M 15.2,13.2 H 15.3 M 17.8,10.8 H 17.9 M 5.5,6 H 18.5 C 20.8,6 22,8.5 22,12 C 22,16.2 20,18.5 17.8,18.5 C 16.3,18.5 15.3,17.2 14,15.8 H 10 C 8.7,17.2 7.7,18.5 6.2,18.5 C 4,18.5 2,16.2 2,12 C 2,8.5 3.2,6 5.5,6 Z"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{x:Bind BadgeCategory}"
                                                                           FontSize="11"
                                                                           FontWeight="Medium"
                                                                           MaxLines="1"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{StaticResource MediaPillForegroundBrush}"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>

                                                        <Border Grid.Column="1"
                                                                Background="{ThemeResource MediaOverlayChipBrush}"
                                                                BorderBrush="{ThemeResource MediaOverlayChipBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Height="22"
                                                                Padding="7,0"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind TopRightBadgeText, Mode=OneWay}"
                                                                       Style="{StaticResource Mono}"
                                                                       FontSize="11"
                                                                       FontWeight="Medium"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource MediaPillForegroundBrush}"/>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Duration Stamp -->
                                                    <Border Background="{ThemeResource MediaOverlayChipBrush}"
                                                            BorderBrush="{ThemeResource MediaOverlayChipBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Height="22"
                                                            Padding="7,0"
                                                            Margin="8"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom">
                                                        <TextBlock Text="{x:Bind DurationText, Mode=OneWay}"
                                                                   Style="{StaticResource Mono}"
                                                                   FontSize="11"
                                                                   FontWeight="Medium"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource MediaPillForegroundBrush}"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Card Footer (timestamp + edit marker & resolution — never repeats badge label) -->
                                                <Grid Padding="12,10,8,10" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{x:Bind CardTitleText, Mode=OneWay}"
                                                                   FontSize="12.5"
                                                                   FontWeight="Medium"
                                                                   Typography.NumeralAlignment="Tabular"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{ThemeResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{x:Bind ResolutionText, Mode=OneWay}"
                                                                   FontSize="11.5"
                                                                   Typography.NumeralAlignment="Tabular"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{ThemeResource TextSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                Spacing="4"
                                                                VerticalAlignment="Center">
                                                        <Button Style="{StaticResource MediaCardActionButtonStyle}"
                                                                Click="CardOpenFolderButton_Click"
                                                                ToolTipService.ToolTip="show in explorer">
                                                            <Path Width="14" Height="14" Stretch="Uniform"
                                                                  Stroke="{ThemeResource TextSecondaryBrush}"
                                                                  StrokeThickness="1.5"
                                                                  StrokeLineJoin="Round"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  VerticalAlignment="Center"
                                                                  Data="M 3,6.5 A 1.5,1.5 0 0 1 4.5,5 H 9.5 L 11.5,7.5 H 19.5 A 1.5,1.5 0 0 1 21,9 V 18 A 1.5,1.5 0 0 1 19.5,19.5 H 4.5 A 1.5,1.5 0 0 1 3,18 Z"/>
                                                        </Button>
                                                        <Button Style="{StaticResource MediaCardActionButtonStyle}"
                                                                Click="CardDeleteButton_Click"
                                                                ToolTipService.ToolTip="delete clip">
                                                            <Path Width="14" Height="14" Stretch="Uniform"
                                                                  Stroke="{ThemeResource TextSecondaryBrush}"
                                                                  StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  VerticalAlignment="Center"
                                                                  Data="M 3.5,6 H 20.5 M 8.5,6 V 4 A 1,1 0 0 1 9.5,3 H 14.5 A 1,1 0 0 1 15.5,4 V 6 M 5.5,6 V 19.5 A 1.5,1.5 0 0 0 7,21 H 17 A 1.5,1.5 0 0 0 18.5,19.5 V 6 M 10,10.5 V 16.5 M 14,10.5 V 16.5"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>

                            <Border x:Name="GalleryEmptyState"
                                    Visibility="Collapsed"
                                    Style="{StaticResource Card}"
                                    Padding="24,32">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <Border Width="40"
                                            Height="40"
                                            CornerRadius="6"
                                            Background="{ThemeResource SurfaceElevatedBrush}"
                                            BorderBrush="{ThemeResource HairlineBrush}"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center">
                                        <Path Width="16" Height="16" Stretch="Uniform"
                                              Stroke="{ThemeResource AccentIndicatorBrush}"
                                              StrokeThickness="1.5"
                                              StrokeLineJoin="Round"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 2,3 H 14 C 14.8,3 15.5,3.7 15.5,4.5 V 11.5 C 15.5,12.3 14.8,13 14,13 H 2 C 1.2,13 0.5,12.3 0.5,11.5 V 4.5 C 0.5,3.7 1.2,3 2,3 Z M 6.5,5.5 L 10.5,8 L 6.5,10.5 Z"/>
                                    </Border>
                                    <TextBlock Text="no replays yet"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="EmptyGalleryHintText"
                                               Text="press shift + s while recording to save your first clip to videos\replays"
                                               Style="{StaticResource Mono}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="400"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- PAGE 2: SETTINGS (scrolls cleanly beneath full-width blurred header) -->
            <ScrollViewer x:Name="SettingsPage"
                          Style="{StaticResource PageScrollViewerStyle}"
                          Foreground="{ThemeResource TextPrimaryBrush}"
                          Visibility="Collapsed"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid Padding="24,72,24,72">
                    <StackPanel x:Name="SettingsContent"
                                MaxWidth="720"
                                HorizontalAlignment="Stretch"
                                Spacing="24">

                        <!-- 1. REPLAY TARGET -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="replay target" Style="{StaticResource SettingGroupHeader}"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <local:SettingRow Label="capture target">
                                        <ComboBox x:Name="CaptureTargetCombo"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="4"
                                                  SelectionChanged="CaptureTargetCombo_SelectionChanged">
                                            <ComboBoxItem Content="whole desktop"/>
                                            <ComboBoxItem Content="game capture"/>
                                        </ComboBox>
                                    </local:SettingRow>

                                    <Rectangle x:Name="MonitorDivider" Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow x:Name="CaptureMonitorRow" Label="display">
                                        <ComboBox x:Name="CaptureMonitorCombo"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="4"
                                                  SelectionChanged="CaptureMonitorCombo_SelectionChanged"/>
                                    </local:SettingRow>

                                    <Rectangle x:Name="GamesRuleDivider" Height="1" Fill="{ThemeResource HairlineBrush}" Visibility="Collapsed"/>

                                    <local:SettingRow x:Name="CustomGamesRow" Label="recognized games" Visibility="Collapsed">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="GamesSummaryText"
                                                       Text="8,460 built-in"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource SettingsInputButtonStyle}"
                                                    Padding="12,0"
                                                    Content="manage..."
                                                    Click="ManageGamesButton_Click"/>
                                        </Grid>
                                    </local:SettingRow>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow Label="show mouse cursor">
                                        <ToggleSwitch x:Name="CaptureCursorToggle"
                                                      HorizontalAlignment="Right"
                                                      MinWidth="0"
                                                      OnContent=""
                                                      OffContent=""
                                                      Toggled="WindowCaptureOption_Changed"/>
                                    </local:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 2. VIDEO QUALITY -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="video quality" Style="{StaticResource SettingGroupHeader}"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <local:SettingRow Label="replay duration">
                                        <ComboBox x:Name="DurationCombo"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="4"
                                                  SelectionChanged="DurationCombo_SelectionChanged">
                                            <ComboBoxItem Content="30 seconds"/>
                                            <ComboBoxItem Content="60 seconds"/>
                                            <ComboBoxItem Content="120 seconds"/>
                                            <ComboBoxItem Content="180 seconds"/>
                                            <ComboBoxItem Content="240 seconds"/>
                                            <ComboBoxItem Content="300 seconds"/>
                                        </ComboBox>
                                    </local:SettingRow>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow Label="frame rate">
                                        <ComboBox x:Name="FpsCombo"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="4"
                                                  SelectionChanged="FpsCombo_SelectionChanged">
                                            <ComboBoxItem Content="30 fps"/>
                                            <ComboBoxItem Content="60 fps"/>
                                            <ComboBoxItem Content="120 fps"/>
                                        </ComboBox>
                                    </local:SettingRow>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow Label="quality">
                                        <ComboBox x:Name="QualityCombo"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="4"
                                                  SelectionChanged="QualityCombo_SelectionChanged">
                                            <ComboBoxItem Content="low"/>
                                            <ComboBoxItem Content="balanced"/>
                                            <ComboBoxItem Content="high"/>
                                            <ComboBoxItem Content="ultra"/>
                                        </ComboBox>
                                    </local:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 3. AUDIO -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="audio" Style="{StaticResource SettingGroupHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Padding="16,12,16,0">
                                <StackPanel>
                                    <local:SettingRow Label="microphone">
                                        <ComboBox x:Name="MicCombo"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="4"
                                                  SelectionChanged="MicCombo_SelectionChanged"/>
                                    </local:SettingRow>

                                    <Border Background="{ThemeResource CardSecondaryBrush}"
                                            BorderBrush="{ThemeResource HairlineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,8"
                                            Margin="0,4,0,12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="108"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="MicLiveDot"
                                                     Width="8"
                                                     Height="8"
                                                     Fill="{ThemeResource SuccessBrush}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock x:Name="MicStatusLabel"
                                                       Grid.Column="1"
                                                       Text="detecting active microphone..."
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="2"
                                                    Height="3"
                                                    CornerRadius="1.5"
                                                    Background="{ThemeResource TrackBrush}"
                                                    VerticalAlignment="Center">
                                                <Border x:Name="MicLevelBarFill"
                                                        Height="3"
                                                        CornerRadius="1.5"
                                                        Background="{ThemeResource AccentIndicatorBrush}"
                                                        RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform x:Name="MicLevelBarScale" ScaleX="0" ScaleY="1"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                            <Button x:Name="DetectMicButton"
                                                    Grid.Column="3"
                                                    Style="{StaticResource BaseButtonStyle}"
                                                    Height="28"
                                                    MinHeight="28"
                                                    CornerRadius="4"
                                                    Padding="12,0"
                                                    FontSize="12"
                                                    Content="detect active"
                                                    Click="DetectMicButton_Click"
                                                    ToolTipService.ToolTip="scan active microphones and select speaking input or default"/>
                                        </Grid>
                                    </Border>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow Label="record microphone">
                                        <ToggleSwitch x:Name="MicToggle"
                                                      HorizontalAlignment="Right"
                                                      MinWidth="0"
                                                      OnContent=""
                                                      OffContent=""
                                                      Toggled="MicToggle_Changed"/>
                                    </local:SettingRow>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow x:Name="RecordAudioRow" Label="record system audio">
                                        <ToggleSwitch x:Name="SysAudioToggle"
                                                      HorizontalAlignment="Right"
                                                      MinWidth="0"
                                                      OnContent=""
                                                      OffContent=""
                                                      Toggled="SysAudioToggle_Changed"/>
                                    </local:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 4. STORAGE AND HOTKEYS -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="storage and hotkeys" Style="{StaticResource SettingGroupHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Padding="16,12,16,0">
                                <StackPanel>
                                    <TextBlock Text="save location"
                                               FontSize="13.5"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <Grid ColumnSpacing="16" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="248"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SaveLocationBox"
                                                 Grid.Column="0"
                                                 Height="32"
                                                 CornerRadius="4"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="SaveLocationBox_TextChanged"/>
                                        <Button x:Name="BrowseSaveLocationButton"
                                                Grid.Column="1"
                                                HorizontalAlignment="Stretch"
                                                Style="{StaticResource SettingsInputButtonStyle}"
                                                Click="BrowseSaveLocationButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Path Width="14" Height="12" Stretch="Uniform"
                                                      Stroke="{Binding Foreground, ElementName=BrowseSaveLocationButton}"
                                                      StrokeThickness="1.4"
                                                      StrokeLineJoin="Round"
                                                      Data="M 1.5,2 H 5.5 L 7,3.5 H 13.5 C 14.3,3.5 15,4.2 15,5 V 11 C 15,11.8 14.3,12.5 13.5,12.5 H 2.5 C 1.7,12.5 1,11.8 1,11 V 3 C 1,2.4 1.2,2 1.5,2 Z"/>
                                                <TextBlock x:Name="BrowseSaveText"
                                                           Text="browse"
                                                           FontSize="12.5"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow Label="save replay hotkey">
                                        <Button x:Name="HotkeyCaptureButton"
                                                HorizontalAlignment="Stretch"
                                                Style="{StaticResource SettingsInputButtonStyle}"
                                                Click="HotkeyCaptureButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Path Width="14" Height="11" Stretch="Uniform"
                                                      Stroke="{Binding Foreground, ElementName=HotkeyCaptureButton}"
                                                      StrokeThickness="1.4"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M 1.5,1 H 12.5 C 13.3,1 14,1.7 14,2.5 V 8.5 C 14,9.3 13.3,10 12.5,10 H 1.5 C 0.7,10 0,9.3 0,8.5 V 2.5 C 0,1.7 0.7,1 1.5,1 Z M 3.5,4 H 4.5 M 6.5,4 H 7.5 M 9.5,4 H 10.5 M 4,7 H 10"/>
                                                <TextBlock x:Name="HotkeyCaptureText"
                                                           Text="shift + s"
                                                           FontSize="12.5"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </local:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 5. APP -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="app" Style="{StaticResource SettingGroupHeader}"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <local:SettingRow Label="start with windows">
                                        <ToggleSwitch x:Name="StartupToggle"
                                                      HorizontalAlignment="Right"
                                                      MinWidth="0"
                                                      OnContent=""
                                                      OffContent=""
                                                      Toggled="StartupToggle_Changed"/>
                                    </local:SettingRow>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow Label="dark mode">
                                        <ToggleSwitch x:Name="ThemeToggle"
                                                      AutomationProperties.Name="dark mode toggle"
                                                      HorizontalAlignment="Right"
                                                      MinWidth="0"
                                                      OnContent=""
                                                      OffContent=""
                                                      Toggled="ThemeToggle_Changed"/>
                                    </local:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 6. ADVANCED -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="advanced" Style="{StaticResource SettingGroupHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Padding="16,12,16,0">
                                <StackPanel>
                                    <Border Background="{ThemeResource WarningBgBrush}"
                                            BorderBrush="{ThemeResource WarningBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,8"
                                            Margin="0,0,0,8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Width="16" Height="16" Stretch="Uniform"
                                                  Stroke="{ThemeResource ErrorBrush}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  VerticalAlignment="Top"
                                                  Margin="0,2,0,0"
                                                  Data="M 8,2 L 14.5,13.5 H 1.5 Z M 8,6.5 V 9.5 M 8,11.5 V 11.8"/>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="capture compatibility"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                                                <TextBlock Text="encoder and capture-method changes can affect performance and fullscreen compatibility. auto and wgc are recommended."
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <local:SettingRow Label="video encoder">
                                        <ComboBox x:Name="EncoderCombo"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="4"
                                                  SelectionChanged="EncoderCombo_SelectionChanged">
                                            <ComboBoxItem Content="auto"/>
                                            <ComboBoxItem Content="hardware"/>
                                            <ComboBoxItem Content="software"/>
                                        </ComboBox>
                                    </local:SettingRow>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow Label="capture method">
                                        <ComboBox x:Name="CaptureMethodCombo"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="4"
                                                  SelectionChanged="CaptureMethodCombo_SelectionChanged">
                                            <ComboBoxItem x:Name="CaptureWgcItem" Content="wgc"/>
                                            <ComboBoxItem x:Name="CaptureDxgiItem" Content="dxgi"/>
                                        </ComboBox>
                                    </local:SettingRow>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <local:SettingRow Label="debug logging">
                                        <ToggleSwitch x:Name="DebugToggle"
                                                      HorizontalAlignment="Right"
                                                      MinWidth="0"
                                                      OnContent=""
                                                      OffContent=""
                                                      Toggled="DebugToggle_Changed"/>
                                    </local:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 7. UPDATES -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="updates" Style="{StaticResource SettingGroupHeader}"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <local:SettingRow Label="check automatically">
                                        <ToggleSwitch x:Name="AutoUpdateToggle"
                                                      HorizontalAlignment="Right"
                                                      MinWidth="0"
                                                      OnContent=""
                                                      OffContent=""
                                                      Toggled="AutoUpdateToggle_Changed"/>
                                    </local:SettingRow>

                                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}"/>

                                    <Grid MinHeight="52" Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="UpdateVersionText"
                                                       Text="version 1.0.0"
                                                       FontSize="13.5"
                                                       Foreground="{ThemeResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="UpdateStatusText"
                                                       Text="check github releases for newer builds"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Button x:Name="CheckUpdateButton"
                                                Grid.Column="1"
                                                AutomationProperties.Name="check for updates"
                                                Style="{StaticResource BaseButtonStyle}"
                                                Height="32"
                                                MinHeight="32"
                                                Padding="14,0"
                                                CornerRadius="4"
                                                VerticalAlignment="Center"
                                                Click="CheckUpdateButton_Click">
                                            <TextBlock x:Name="CheckUpdateButtonText"
                                                       Text="check for updates"
                                                       FontSize="12.5"
                                                       FontWeight="Medium"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- INLINE REPLAY VIEWER OVERLAY -->
            <Grid x:Name="ViewerPage"
                  Visibility="Collapsed"
                  Background="{ThemeResource BgBrush}"
                  Padding="24,68,24,20"
                  Canvas.ZIndex="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Properly spaced non-colliding viewer toolbar -->
                <Grid x:Name="ViewerToolbar" Margin="0,0,0,12" Height="36" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ViewerBackButton"
                            AutomationProperties.Name="back to gallery"
                            Style="{StaticResource BaseButtonStyle}"
                            Height="32"
                            MinHeight="32"
                            CornerRadius="4"
                            Padding="12,0"
                            Click="ViewerBackButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{Binding Foreground, ElementName=ViewerBackButton}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  VerticalAlignment="Center"
                                  Data="M 19,12 H 5 M 11,6 L 5,12 L 11,18"/>
                            <TextBlock x:Name="ViewerBackLabel"
                                       Text="back to gallery"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Grid Grid.Column="1"
                          ColumnSpacing="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource SurfaceElevatedBrush}"
                                BorderBrush="{ThemeResource HairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Height="28"
                                Padding="9,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="ViewerCategoryText"
                                       Text="desktop"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       MaxWidth="200"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </Border>
                        <TextBlock x:Name="ViewerMetaText"
                                   Grid.Column="1"
                                   Text=""
                                   Style="{StaticResource Mono}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button x:Name="ViewerEditButton"
                                AutomationProperties.Name="edit"
                                Style="{StaticResource BaseButtonStyle}"
                                Height="32"
                                MinHeight="32"
                                CornerRadius="4"
                                Padding="12,0"
                                Click="ViewerEditButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{Binding Foreground, ElementName=ViewerEditButton}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      VerticalAlignment="Center"
                                      Data="M 8.5,12.5 L 11.5,15.5 L 21.3,5.7 A 2.1,2.1 0 0 0 18.3,2.7 Z M 9.8,14.2 C 7.2,14.2 6.2,16.2 5.3,17.8 C 4.7,19 3.6,19.7 2.6,20 C 4.8,20.8 7.3,20.7 9.1,19.3 C 10.5,18.2 11.2,16.7 10.8,15.2"/>
                                <TextBlock x:Name="ViewerEditText"
                                           Text="edit"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ViewerOpenFolderButton"
                                Style="{StaticResource BaseButtonStyle}"
                                Height="32"
                                MinHeight="32"
                                CornerRadius="4"
                                Padding="12,0"
                                Click="ViewerOpenFolderButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{Binding Foreground, ElementName=ViewerOpenFolderButton}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      VerticalAlignment="Center"
                                      Data="M 3,6.5 A 1.5,1.5 0 0 1 4.5,5 H 9.5 L 11.5,7.5 H 19.5 A 1.5,1.5 0 0 1 21,9 V 18 A 1.5,1.5 0 0 1 19.5,19.5 H 4.5 A 1.5,1.5 0 0 1 3,18 Z"/>
                                <TextBlock x:Name="ViewerFolderText"
                                           Text="show in folder"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ViewerDeleteButton"
                                AutomationProperties.Name="delete"
                                Style="{StaticResource DangerButtonStyle}"
                                Height="32"
                                MinHeight="32"
                                CornerRadius="4"
                                Padding="12,0"
                                Click="ConfirmDeleteButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{Binding Foreground, ElementName=ViewerDeleteButton}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      VerticalAlignment="Center"
                                      Data="M 3.5,6 H 20.5 M 8.5,6 V 4 A 1,1 0 0 1 9.5,3 H 14.5 A 1,1 0 0 1 15.5,4 V 6 M 5.5,6 V 19.5 A 1.5,1.5 0 0 0 7,21 H 17 A 1.5,1.5 0 0 0 18.5,19.5 V 6 M 10,10.5 V 16.5 M 14,10.5 V 16.5"/>
                                <TextBlock x:Name="ViewerDeleteText"
                                           Text="delete"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Trim Timeline + Crop Export Bar (Row 2, declared before WebView2 so UIA/Tab stays reachable) -->
                <Border x:Name="EditorBar"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Margin="0,12,0,0"
                        Background="{ThemeResource SurfaceBrush}"
                        BorderBrush="{ThemeResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                    <StackPanel Spacing="10">

                        <!-- Row A: Trim Range Slider -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="EditPlayPauseButton"
                                    AutomationProperties.Name="play pause trim preview"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Width="32" Height="30"
                                    Padding="0"
                                    CornerRadius="4"
                                    Click="EditPlayPauseButton_Click">
                                <Grid Width="14" Height="14">
                                    <Path x:Name="EditPlayIcon"
                                          Width="11" Height="12" Stretch="Uniform"
                                          Fill="{Binding Foreground, ElementName=EditPlayPauseButton}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M 1,0.5 L 10.5,6 L 1,11.5 Z"/>
                                    <Path x:Name="EditPauseIcon"
                                          Visibility="Collapsed"
                                          Width="10" Height="11" Stretch="Uniform"
                                          Fill="{Binding Foreground, ElementName=EditPlayPauseButton}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M 1,0 H 3.8 V 11 H 1 Z M 6.2,0 H 9 V 11 H 6.2 Z"/>
                                </Grid>
                            </Button>

                            <TextBlock x:Name="TrimStartText"
                                       Grid.Column="1"
                                       Text="0:00.0"
                                       Style="{StaticResource Mono}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       MinWidth="46"
                                       TextAlignment="Center"/>

                            <Grid x:Name="TrimTrackGrid"
                                  Grid.Column="2"
                                  Height="30"
                                  Background="Transparent"
                                  SizeChanged="TrimTrackGrid_SizeChanged"
                                  PointerPressed="TrimTrackGrid_PointerPressed"
                                  PointerMoved="TrimTrackGrid_PointerMoved"
                                  PointerReleased="TrimTrackGrid_PointerReleased"
                                  PointerCaptureLost="TrimTrackGrid_PointerReleased">
                                <Border Height="6"
                                        CornerRadius="3"
                                        Background="{ThemeResource TrackBrush}"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"/>
                                <Border x:Name="TrimActiveFill"
                                        Height="6"
                                        CornerRadius="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentIndicatorBrush}"
                                        IsHitTestVisible="False"/>
                                <Border x:Name="TrimPlayhead"
                                        Width="2"
                                        Height="22"
                                        CornerRadius="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource TextPrimaryBrush}"
                                        IsHitTestVisible="False"/>
                                <Border x:Name="TrimStartHandle"
                                        Width="12"
                                        Height="22"
                                        CornerRadius="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource TextPrimaryBrush}"
                                        BorderBrush="{ThemeResource BgBrush}"
                                        BorderThickness="1.5"
                                        IsHitTestVisible="False">
                                    <Border Width="2" Height="10" CornerRadius="1" Background="{ThemeResource BgBrush}"/>
                                </Border>
                                <Border x:Name="TrimEndHandle"
                                        Width="12"
                                        Height="22"
                                        CornerRadius="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource TextPrimaryBrush}"
                                        BorderBrush="{ThemeResource BgBrush}"
                                        BorderThickness="1.5"
                                        IsHitTestVisible="False">
                                    <Border Width="2" Height="10" CornerRadius="1" Background="{ThemeResource BgBrush}"/>
                                </Border>
                            </Grid>

                            <TextBlock x:Name="TrimEndText"
                                       Grid.Column="3"
                                       Text="0:00.0"
                                       Style="{StaticResource Mono}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       MinWidth="46"
                                       TextAlignment="Center"/>

                            <Border Grid.Column="4"
                                    Background="{ThemeResource SurfaceElevatedBrush}"
                                    BorderBrush="{ThemeResource HairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Height="28"
                                    Padding="9,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="TrimDurationText"
                                           Text="0.0s"
                                           Style="{StaticResource Mono}"
                                           FontSize="11.5"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>

                        <!-- Row B: Crop Aspect Ratios + Save as Separate Video -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="crop"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>
                                <Button x:Name="CropRatioFreeButton"
                                        Content="free"
                                        Tag="free"
                                        Height="28"
                                        MinHeight="28"
                                        Padding="10,0"
                                        CornerRadius="4"
                                        FontSize="12"
                                        Style="{StaticResource FilterActiveButtonStyle}"
                                        Click="CropRatioButton_Click"/>
                                <Button x:Name="CropRatio169Button"
                                        Content="16:9"
                                        Tag="16:9"
                                        Height="28"
                                        MinHeight="28"
                                        Padding="10,0"
                                        CornerRadius="4"
                                        FontSize="12"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Click="CropRatioButton_Click"/>
                                <Button x:Name="CropRatio43Button"
                                        Content="4:3"
                                        Tag="4:3"
                                        Height="28"
                                        MinHeight="28"
                                        Padding="10,0"
                                        CornerRadius="4"
                                        FontSize="12"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Click="CropRatioButton_Click"/>
                                <Button x:Name="CropRatio916Button"
                                        Content="9:16"
                                        Tag="9:16"
                                        Height="28"
                                        MinHeight="28"
                                        Padding="10,0"
                                        CornerRadius="4"
                                        FontSize="12"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Click="CropRatioButton_Click"/>
                                <Button x:Name="CropRatio11Button"
                                        Content="1:1"
                                        Tag="1:1"
                                        Height="28"
                                        MinHeight="28"
                                        Padding="10,0"
                                        CornerRadius="4"
                                        FontSize="12"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Click="CropRatioButton_Click"/>

                                <Border Background="{ThemeResource SurfaceElevatedBrush}"
                                        BorderBrush="{ThemeResource HairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Height="28"
                                        Padding="9,0"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="CropInfoText"
                                               Text="—"
                                               Style="{StaticResource Mono}"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="EditExportProgressText"
                                           Visibility="Collapsed"
                                           Text="saving 0%"
                                           Style="{StaticResource Mono}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="EditCancelExportButton"
                                        Visibility="Collapsed"
                                        Content="cancel"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Height="28"
                                        MinHeight="28"
                                        Padding="12,0"
                                        CornerRadius="4"
                                        Click="EditCancelExportButton_Click"/>
                                <Button x:Name="EditResetButton"
                                        Content="reset"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Height="28"
                                        MinHeight="28"
                                        Padding="12,0"
                                        CornerRadius="4"
                                        Click="EditResetButton_Click"/>
                                <Button x:Name="EditSaveCopyButton"
                                        AutomationProperties.Name="save as new video"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Height="28"
                                        MinHeight="28"
                                        Padding="14,0"
                                        CornerRadius="4"
                                        Click="EditSaveCopyButton_Click">
                                    <TextBlock x:Name="EditSaveCopyText"
                                               Text="save copy"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <Grid x:Name="PlayerViewport"
                      Grid.Row="1"
                      SizeChanged="PlayerViewport_SizeChanged">
                    <Border x:Name="PlayerCard"
                            Background="{ThemeResource SurfaceElevatedBrush}"
                            CornerRadius="8"
                            BorderBrush="{ThemeResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <Grid x:Name="InlinePlayerHost">
                            <Grid x:Name="InlineWebHost" Opacity="0"/>
                            <Image x:Name="ViewerPoster"
                                   Visibility="Collapsed"
                                   Stretch="Uniform"
                                   IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================================================================ -->
        <!-- TOP FULL-WIDTH HEADER BAR (solid surface, zero blur)             -->
        <!-- ================================================================ -->
        <Grid x:Name="FloatingHeader"
              Height="52"
              VerticalAlignment="Top"
              Background="{ThemeResource HeaderBarBrush}"
              BorderBrush="{ThemeResource HairlineBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,0,8,0"
              Canvas.ZIndex="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Clean Status Indicator Only (no brand logo/text clutter) -->
            <Border x:Name="StatusPill"
                    Grid.Column="0"
                    Background="{ThemeResource CardSecondaryBrush}"
                    BorderBrush="{ThemeResource HairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Height="26"
                    Padding="8,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse x:Name="RecDot"
                             Width="7"
                             Height="7"
                             Fill="{ThemeResource TextTertiaryBrush}"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusHeadline"
                               Text="stopped"
                               FontSize="11.5"
                               FontWeight="Medium"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Center: Horizontal Fluent 2.0 Selector Switcher -->
            <Border x:Name="NavSegmentedCapsule"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource NavSelectorTrayBrush}"
                    BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Height="36"
                    Padding="3">
                <Grid>
                    <!-- Smooth horizontal Composition pill -->
                    <Border x:Name="NavActivePill"
                            Width="92"
                            Height="28"
                            CornerRadius="4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{ThemeResource NavActivePillBrush}"
                            BorderBrush="{ThemeResource NavActivePillBorderBrush}"
                            BorderThickness="1"
                            IsHitTestVisible="False"/>

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="NavHomeButton"
                                AutomationProperties.Name="home"
                                Width="92"
                                Style="{StaticResource NavRailButtonStyle}"
                                Click="NavHomeButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Path x:Name="NavHomeIcon"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{Binding Foreground, ElementName=NavHomeButton}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      VerticalAlignment="Center"
                                      Data="M 3,10.5 L 12,3 L 21,10.5 V 19.5 A 1.5,1.5 0 0 1 19.5,21 H 15 V 14.5 H 9 V 21 H 4.5 A 1.5,1.5 0 0 1 3,19.5 Z"/>
                                <TextBlock x:Name="NavHomeText"
                                           Text="home"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavSettingsButton"
                                AutomationProperties.Name="settings"
                                Width="92"
                                Style="{StaticResource NavRailButtonStyle}"
                                Click="NavSettingsButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Path x:Name="NavSettingsIcon"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{Binding Foreground, ElementName=NavSettingsButton}"
                                      StrokeThickness="1.45"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      VerticalAlignment="Center"
                                      Data="M 19.4,15 A 1.65,1.65 0 0 0 19.73,16.82 L 19.79,16.88 A 2,2 0 1 1 16.96,19.71 L 16.9,19.65 A 1.65,1.65 0 0 0 15.08,19.32 A 1.65,1.65 0 0 0 14,20.85 V 21 A 2,2 0 1 1 10,21 V 20.91 A 1.65,1.65 0 0 0 8.92,19.4 A 1.65,1.65 0 0 0 7.1,19.73 L 7.04,19.79 A 2,2 0 1 1 4.21,16.96 L 4.27,16.9 A 1.65,1.65 0 0 0 4.6,15.08 A 1.65,1.65 0 0 0 3.15,14 H 3 A 2,2 0 1 1 3,10 H 3.09 A 1.65,1.65 0 0 0 4.6,8.92 A 1.65,1.65 0 0 0 4.27,7.1 L 4.21,7.04 A 2,2 0 1 1 7.04,4.21 L 7.1,4.27 A 1.65,1.65 0 0 0 8.92,4.6 H 9 A 1.65,1.65 0 0 0 10,3.09 V 3 A 2,2 0 1 1 14,3 V 3.09 A 1.65,1.65 0 0 0 15.08,4.6 A 1.65,1.65 0 0 0 16.9,4.27 L 16.96,4.21 A 2,2 0 1 1 19.79,7.04 L 19.73,7.1 A 1.65,1.65 0 0 0 19.4,8.92 V 9 A 1.65,1.65 0 0 0 20.91,10 H 21 A 2,2 0 1 1 21,14 H 20.91 A 1.65,1.65 0 0 0 19.4,15 Z M 15,12 A 3,3 0 1 1 9,12 A 3,3 0 1 1 15,12 Z"/>
                                <TextBlock x:Name="NavSettingsText"
                                           Text="settings"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Window Caption Buttons -->
            <StackPanel x:Name="WindowButtonsCapsule"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="MinimizeTitleButton"
                        AutomationProperties.Name="minimize"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        local:UiHover.HoverIconTone="Primary"
                        IsTabStop="False"
                        Click="MinimizeTitleButton_Click"
                        ToolTipService.ToolTip="minimize">
                    <Path Width="10" Height="2"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="{ThemeResource TextSecondaryBrush}"
                          Data="M 0,0.4 H 10 V 1.6 H 0 Z"/>
                </Button>
                <Button x:Name="CloseTitleButton"
                        AutomationProperties.Name="hide to tray"
                        Style="{StaticResource TitleBarCloseButtonStyle}"
                        local:UiHover.HoverIconTone="White"
                        IsTabStop="False"
                        Click="CloseTitleButton_Click"
                        ToolTipService.ToolTip="hide to tray">
                    <Path Width="10" Height="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Stroke="{ThemeResource TextSecondaryBrush}"
                          StrokeThickness="1.25"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M 1,1 L 9,9 M 9,1 L 1,9"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- FLOATING UNSAVED CHANGES BAR -->
        <Border x:Name="PendingChangesFlyout"
                Canvas.ZIndex="25"
                Background="{ThemeResource FlyoutAcrylicBrush}"
                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Height="44"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,16"
                Visibility="Collapsed"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PendingFlyoutSlide" Y="12"/>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="16,0,8,0" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{ThemeResource AccentIndicatorBrush}"/>
                <TextBlock Text="unsaved changes"
                           FontSize="12.5"
                           FontWeight="Medium"
                           Foreground="{ThemeResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <Button x:Name="PendingDiscardButton"
                        Style="{StaticResource BaseButtonStyle}"
                        Height="28"
                        MinHeight="28"
                        CornerRadius="4"
                        Padding="12,0"
                        Content="discard"
                        Click="PendingDiscardButton_Click"/>
                <Button x:Name="PendingSaveButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Height="28"
                        MinHeight="28"
                        CornerRadius="4"
                        Padding="16,0"
                        Content="save"
                        Click="PendingSaveButton_Click"/>
            </StackPanel>
        </Border>

        <!-- STATUS INFOBAR -->
        <InfoBar x:Name="StatusInfoBar"
                 Canvas.ZIndex="30"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 MaxWidth="560"
                 Margin="24,0,24,16"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Informational"/>

        <!-- WEBVIEW2 RUNTIME WARNING -->
        <InfoBar x:Name="WebViewRequirementBar"
                 Canvas.ZIndex="30"
                 Visibility="Collapsed"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 MaxWidth="560"
                 Margin="24,0,24,16"
                 IsOpen="False"
                 IsClosable="False"
                 Severity="Warning"
                 Title="webview2 runtime required"
                 Message="video playback needs microsoft edge webview2 runtime.">
            <InfoBar.ActionButton>
                <Button Content="download webview2" Click="DownloadWebView2Button_Click"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Crisp 1px perimeter border framing the Acrylic window -->
        <Border IsHitTestVisible="False"
                BorderBrush="{ThemeResource WindowRimBorderBrush}"
                BorderThickness="1"
                Canvas.ZIndex="40"/>
    </Grid>
</Window>
